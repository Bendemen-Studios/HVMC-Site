Options -MultiViews
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# Bestaande bestanden blijven rechtstreeks bereikbaar.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Mooie sectie-URL's zoals /aanmelden en /server-regels
# laden de single-page website zonder een 404.
RewriteRule ^ index.html [L]

# Extra fallback voor hosts waarop de rewrite-regel niet wordt toegepast.
ErrorDocument 404 /index.html
