RewriteEngine On

# Dedicated server rules page.
RewriteRule ^server-regels/?$ /regels [R=301,L]
RewriteRule ^regels/?$ server-regels.html [L]

# Laat bestaande bestanden en mappen ongemoeid.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Overige section-URLs zoals /aanmelden laden de single-page index.
RewriteRule ^ index.html [L]
